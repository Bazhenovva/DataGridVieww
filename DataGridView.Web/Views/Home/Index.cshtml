@using System.Globalization
@using DataGridView.Models
@model System.Collections.Generic.IReadOnlyCollection<DataGridView.Models.Product>

@{
	ViewData["Title"] = "Реестр товаров";
}

@functions {
	string GetMaterialDisplayName(Material material) => material switch
	{
		Material.Steel => "Сталь",
		Material.Copper => "Медь",
		Material.Iron => "Железо",
		Material.Chrome => "Хром",
		_ => material.ToString()
	};

	string GetProductSizeDisplayName(ProductSize size) => size switch
	{
		ProductSize.M6 => "M6",
		ProductSize.M8 => "M8",
		ProductSize.M10 => "M10",
		ProductSize.M12 => "M12",
		ProductSize.Size10Mm => "10 мм",
		ProductSize.Size20Mm => "20 мм",
		_ => size.ToString()
	};
}

<div class="container mt-4">
	<h2 class="mb-4">Реестр товаров</h2>

	@if (Model == null || Model.Count == 0)
	{
		<div class="alert alert-info">Товаров пока нет</div>
	}
	else
	{
		<table class="table table-bordered">
			<thead>
				<tr>
					<th>ID</th>
					<th>Название</th>
					<th>Размер</th>
					<th>Материал</th>
					<th>Цена</th>
					<th>Количество</th>
					<th>Мин. запас</th>
					<th>Общая стоимость</th>
					<th>Действия</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var product in Model)
				{
					<tr>
						<td>@product.Id</td>
						<td>@product.ProductName</td>
						<td>@GetProductSizeDisplayName(product.ProductSize)</td>
						<td>@GetMaterialDisplayName(product.Material)</td>
						<td>@product.Price.ToString("F2", CultureInfo.InvariantCulture)</td>
						<td>@product.Quantity</td>
						<td>@product.MinQuantity</td>
						<td>@product.TotalAmount.ToString("F2", CultureInfo.InvariantCulture)</td>
						<td>
							<button type="button" class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#editModal-@product.Id">Изменить</button>
							<button type="button" class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#deleteModal-@product.Id">Удалить</button>
						</td>
					</tr>

					<!-- Модалка редактирования -->
					<div class="modal fade" id="editModal-@product.Id" tabindex="-1">
						<div class="modal-dialog">
							<div class="modal-content">
								<form asp-action="Edit" method="post">
									<div class="modal-header">
										<h5 class="modal-title">Редактировать товар</h5>
										<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
									</div>
									<div class="modal-body">
										<input type="hidden" name="Id" value="@product.Id" />

										<div class="mb-3">
											<label class="form-label">Название товара</label>
											<input name="ProductName" class="form-control" value="@product.ProductName" required minlength="3" maxlength="100" />
											<span class="text-danger" data-valmsg-for="ProductName"></span>
										</div>

										<div class="mb-3">
											<label class="form-label">Размер</label>
											<select name="ProductSize" class="form-select">
												@if (product.ProductSize == ProductSize.M6)
												{
													<option value="M6" selected>M6</option>
												}
												else
												{
													<option value="M6">M6</option>
												}
												@if (product.ProductSize == ProductSize.M8)
												{
													<option value="M8" selected>M8</option>
												}
												else
												{
													<option value="M8">M8</option>
												}
												@if (product.ProductSize == ProductSize.M10)
												{
													<option value="M10" selected>M10</option>
												}
												else
												{
													<option value="M10">M10</option>
												}
												@if (product.ProductSize == ProductSize.M12)
												{
													<option value="M12" selected>M12</option>
												}
												else
												{
													<option value="M12">M12</option>
												}
												@if (product.ProductSize == ProductSize.Size10Mm)
												{
													<option value="Size10Mm" selected>10 мм</option>
												}
												else
												{
													<option value="Size10Mm">10 мм</option>
												}
												@if (product.ProductSize == ProductSize.Size20Mm)
												{
													<option value="Size20Mm" selected>20 мм</option>
												}
												else
												{
													<option value="Size20Mm">20 мм</option>
												}
											</select>
										</div>

										<div class="mb-3">
											<label class="form-label">Материал</label>
											<select name="Material" class="form-select">
												@if (product.Material == Material.Steel)
												{
													<option value="Steel" selected>Сталь</option>
												}
												else
												{
													<option value="Steel">Сталь</option>
												}
												@if (product.Material == Material.Copper)
												{
													<option value="Copper" selected>Медь</option>
												}
												else
												{
													<option value="Copper">Медь</option>
												}
												@if (product.Material == Material.Iron)
												{
													<option value="Iron" selected>Железо</option>
												}
												else
												{
													<option value="Iron">Железо</option>
												}
												@if (product.Material == Material.Chrome)
												{
													<option value="Chrome" selected>Хром</option>
												}
												else
												{
													<option value="Chrome">Хром</option>
												}
											</select>
										</div>

										<div class="mb-3">
											<label class="form-label">Цена</label>
											<input name="Price" type="number" step="0.01" min="0.01" max="999999" class="form-control"
												   value="@product.Price.ToString("F2", CultureInfo.InvariantCulture)" required />
											<span class="text-danger" data-valmsg-for="Price"></span>
										</div>
										<div class="mb-3">
											<label class="form-label">Количество</label>
											<input name="Quantity" type="number" min="0" max="100" class="form-control" value="@product.Quantity" required />
											<span class="text-danger" data-valmsg-for="Quantity"></span>
										</div>
										<div class="mb-3">
											<label class="form-label">Минимальный запас</label>
											<input name="MinQuantity" type="number" min="0" max="100" class="form-control" value="@product.MinQuantity" required />
											<span class="text-danger" data-valmsg-for="MinQuantity"></span>
										</div>
									</div>
									<div class="modal-footer">
										<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
										<button type="submit" class="btn btn-primary">Сохранить</button>
									</div>
								</form>
							</div>
						</div>
					</div>

					<!-- Модалка удаления -->
					<div class="modal fade" id="deleteModal-@product.Id" tabindex="-1">
						<div class="modal-dialog">
							<div class="modal-content">
								<form asp-action="Delete" method="post">
									<div class="modal-header">
										<h5 class="modal-title">Удалить товар</h5>
										<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
									</div>
									<div class="modal-body">
										<p>Вы уверены, что хотите удалить этот товар?</p>
										<p><strong>@product.ProductName</strong></p>
										<input type="hidden" name="id" value="@product.Id" />
									</div>
									<div class="modal-footer">
										<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
										<button type="submit" class="btn btn-danger">Удалить</button>
									</div>
								</form>
							</div>
						</div>
					</div>
				}
			</tbody>
		</table>

		<div class="mb-3">Всего товаров: @Model.Count</div>
	}

	<!-- Кнопка добавления -->
	<button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#createModal">Добавить товар</button>
</div>

<!-- Модалка добавления -->
<div class="modal fade" id="createModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<form asp-action="Create" method="post">
				<div class="modal-header">
					<h5 class="modal-title">Добавить товар</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body">
					<div class="mb-3">
						<label class="form-label">Название товара</label>
						<input name="ProductName" class="form-control" required minlength="3" maxlength="100" />
						<span class="text-danger" data-valmsg-for="ProductName"></span>
					</div>
					<div class="mb-3">
						<label class="form-label">Размер</label>
						<select name="ProductSize" class="form-select">
							<option value="M6" selected>M6</option>
							<option value="M8">M8</option>
							<option value="M10">M10</option>
							<option value="M12">M12</option>
							<option value="Size10Mm">10 мм</option>
							<option value="Size20Mm">20 мм</option>
						</select>
					</div>
					<div class="mb-3">
						<label class="form-label">Материал</label>
						<select name="Material" class="form-select">
							<option value="Steel" selected>Сталь</option>
							<option value="Copper">Медь</option>
							<option value="Iron">Железо</option>
							<option value="Chrome">Хром</option>
						</select>
					</div>
					<div class="mb-3">
						<label class="form-label">Цена</label>
						<input name="Price" type="number" step="0.01" min="0.01" max="999999" class="form-control" value="0" required />
						<span class="text-danger" data-valmsg-for="Price"></span>
					</div>
					<div class="mb-3">
						<label class="form-label">Количество</label>
						<input name="Quantity" type="number" min="0" max="100" class="form-control" value="0" required />
						<span class="text-danger" data-valmsg-for="Quantity"></span>
					</div>
					<div class="mb-3">
						<label class="form-label">Минимальный запас</label>
						<input name="MinQuantity" type="number" min="0" max="100" class="form-control" value="0" required />
						<span class="text-danger" data-valmsg-for="MinQuantity"></span>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
					<button type="submit" class="btn btn-primary">Сохранить</button>
				</div>
			</form>
		</div>
	</div>
</div>
